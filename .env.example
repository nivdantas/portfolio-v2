# Public site / external blog (POST /posts currently means publish)
SITE_URL=https://nivdantas.com
BLOG_API_URL=
# Optional: public GitHub REST requests also work without a token
MY_TOKEN=

# Automatic LinkedIn publishing is opt-in and disabled in Vercel previews.
LINKEDIN_PUBLISH_ENABLED=false
LINKEDIN_MEMBER_URN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN_EXPIRES_AT=
LINKEDIN_API_VERSION=202610
LINKEDIN_POST_LOCALE=pt
LINKEDIN_MAX_AGE_HOURS=48

# Durable ledger: use a persistent Upstash Redis database, with no eviction.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Independent, randomly generated secrets. Never prefix these with NEXT_PUBLIC_.
CRON_SECRET=
BLOG_WEBHOOK_SECRET=
